{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": [
    "packages/*/src/**/*",
    "apps/api/src/**/*",
    "apps/bot/src/**/*",
    "scripts/**/*",
    "tests/**/*"
  ]
}
