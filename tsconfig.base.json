{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": false,
    "baseUrl": ".",
    "paths": {
      "@discord-link-hunter/config": ["packages/config/src/index.ts"],
      "@discord-link-hunter/core": ["packages/core/src/index.ts"],
      "@discord-link-hunter/research": ["packages/research/src/index.ts"],
      "@discord-link-hunter/db": ["packages/db/src/index.ts"],
      "@/*": ["apps/web/src/*"]
    }
  }
}
