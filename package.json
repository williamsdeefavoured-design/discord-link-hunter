{
  "name": "discord-link-hunter-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "doctor": "tsx scripts/doctor.ts",
    "register": "tsx scripts/register-commands.ts",
    "dev:api": "npm run dev --workspace=@discord-link-hunter/api",
    "dev:bot": "npm run dev --workspace=@discord-link-hunter/bot",
    "dev:web": "npm run dev --workspace=@discord-link-hunter/web",
    "smoke:mock": "tsx scripts/smoke-mock.ts",
    "smoke:live": "tsx scripts/smoke-live.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

